# Copy to .streamlit/secrets.toml (local) or paste into the app's Secrets box on Streamlit Community Cloud.
# NEVER commit the real secrets.toml — it is listed in .gitignore.
# All settings below are optional: the app starts without any of them and simply disables AI features.

# --- Option A: Anthropic (Claude) -------------------------------------------
ANTHROPIC_API_KEY = "sk-ant-your-key-here"
# ANTHROPIC_MODEL = "claude-opus-5-5"     # default; e.g. "claude-sonnet-5-5" or "claude-haiku-5-5" cost less
# READRAY_ANTHROPIC_FALLBACKS = "true"    # server-side refusal fallback on supported models

# --- Option B: Google Gemini ------------------------------------------------
# GEMINI_API_KEY = "your-gemini-key"      # from https://aistudio.google.com/apikey
# GEMINI_MODEL = "gemini-3.8-flash"       # default

# --- Option C: any other OpenAI-compatible API (OpenAI, Groq, OpenRouter, Gemini, local Ollama…) ---
# READRAY_AI_PROVIDER = "openai_compatible"
# OPENAI_API_KEY = "your-key-here"
# OPENAI_MODEL = "your-provider-model-id"
# OPENAI_BASE_URL = "https://api.groq.com/openai/v1"   # omit for api.openai.com

# --- Protecting your key on a public deployment ------------------------------
# READRAY_ACCESS_CODE = "choose-a-long-random-code"   # visitors must enter it to use YOUR key
# READRAY_MAX_REQUESTS_PER_SESSION = "40"             # cap per browser session on your key
# READRAY_ALLOW_USER_KEYS = "true"                    # let visitors paste their own key for their session

# --- Limits and storage ------------------------------------------------------
# READRAY_MAX_PDF_MB = "50"
# READRAY_MAX_OUTPUT_TOKENS = "8000"
# READRAY_TIMEOUT_SECONDS = "120"
# READRAY_STORAGE = "local"          # LOCAL SINGLE-USER USE ONLY: persist library/notes to READRAY_DATA_DIR
# READRAY_DATA_DIR = ".readray_data"
